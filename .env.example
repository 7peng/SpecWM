# Path environment. Copy to .env for per-machine values (gitignored); precedence: exported shell
# env > .env > .env.example. The Python entry points load it (utils.load_env); for the shell:
#   set -a; source .env; set +a

# root for datasets/ and checkpoints/ (datasets under $STABLEWM_HOME/datasets/<name>.h5)
STABLEWM_HOME=/path/to/stable-wm

# node-local staging directories: the corpora are read at random offsets, so keep them on local disk
SCENE_STAGE_DIR=/tmp/scene_stage
CUBE_STAGE_DIR=/tmp/cube_stage
CALVIN_STAGE_DIR=/tmp/calvin_stage

# CALVIN: the passive dataset root (data/calvin/download_calvin.sh extracts task_ABC_D/ here), the
# simulator checkout and its own venv (make_calvin_suite.py and the CEM env workers run under CALVIN_VENV)
CALVIN_ROOT=/path/to/calvin
CALVIN_ENV_SRC=/path/to/calvin_env_src
CALVIN_VENV=/path/to/calvin-venv

# probe suites and packs (data/ogbench/make_ogbench_suite.py renders the suite into OGBENCH_SUITE_DIR,
# data/probe_suite/build_probe_pack.py packs it; the OGBench pack holds scene/ and cube/; the CALVIN
# pack is copied node-local before training, scripts/stage_calvin.sh)
OGBENCH_SUITE_DIR=/path/to/probe_suite_ogbench
OGBENCH_PACK_DIR=/path/to/probe_pack_ogbench
CALVIN_PROBE_PACK_SRC=/path/to/probe_pack_calvin
CALVIN_PROBE_PACK_DIR=/tmp/probe_pack_calvin

# optional: a second results tree holding the replicate seeds' planning cells (seed_aggregate.py)
# SEED_RESULTS_DIR=/path/to/seed_results
